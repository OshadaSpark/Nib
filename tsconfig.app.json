{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": ["@tsconfig/svelte/tsconfig.json", "./tsconfig.base.json"],
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["svelte", "vite/client"],
    "paths": {
      "$lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vitest.setup.ts"],
  // The service worker has a worker's globals rather than a page's: see tsconfig.worker.json.
  "exclude": ["src/serviceWorker.ts"]
}
