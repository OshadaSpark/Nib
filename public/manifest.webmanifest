{
  "id": "./",
  "name": "nib",
  "short_name": "nib",
  "description": "A minimal Markdown and text editor for local files.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fdfdfc",
  "theme_color": "#fdfdfc",
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/markdown": [".md", ".markdown"],
        "text/plain": [".txt"]
      }
    }
  ],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
