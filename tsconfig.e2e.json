{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "types": ["node"],
    // The E2E tests share the fake disk with the unit tests (`src/lib/files/fakeDisk.ts`).
    "allowImportingTsExtensions": true
  },
  "include": ["e2e/**/*.ts"]
}
